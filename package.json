{
  "name": "nosvelte",
  "version": "0.6.0",
  "author": "Akiomi Kamakura <akiomik@gmail.com>",
  "description": "An experimental Svelte library for building Nostr apps easily",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "LICENSE"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^5.0.0",
    "rx-nostr": "^3.0.0",
    "rx-nostr-crypto": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "mock-socket": "^9.3.1",
    "nostr-typedef": "^0.13.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.0.0",
    "publint": "^0.3.22",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vitest-websocket-mock": "^0.7.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiomik/nosvelte.git"
  },
  "bugs": "https://github.com/akiomik/nosvelte/issues",
  "keywords": [
    "svelte",
    "nostr"
  ]
}
